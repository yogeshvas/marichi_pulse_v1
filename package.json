{
  "name": "marichi-pulse",
  "version": "1.0.0",
  "private": true,
  "description": "Flight and hotel booking system on the Amadeus Self-Service APIs",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
