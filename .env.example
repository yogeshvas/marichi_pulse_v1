# Leave the Amadeus keys empty to run on built-in demo data.
# Get test keys at https://developers.amadeus.com (Self-Service workspace).
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Test environment by default. Use https://api.amadeus.com for production.
AMADEUS_BASE_URL=https://test.api.amadeus.com
# Path for hotel booking. Check the current Amadeus docs if bookings fail.
AMADEUS_HOTEL_ORDER_PATH=/v2/booking/hotel-orders
# Force demo data even when keys are present
USE_MOCK=false

PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
DB_PATH=./data/skyline.db
CURRENCY=ZMW
CORS_ORIGIN=
AGENT_EMAIL=bookings@example.com

# Optional. With a key, the assistant understands more complex sentences and answers open questions.
# Without it, everything still works using built-in rules.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
